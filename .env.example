# ============================================
# 社团管理系统 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- AI 微服务 ----------
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
FALLBACK_API_KEY=your-mimo-api-key
FALLBACK_BASE_URL=https://api.xiaomimimo.com/v1
FALLBACK_MODEL=mimo-v2.5
MULTIMODAL_API_KEY=       # 默认可留空，自动复用 LLM_API_KEY
MULTIMODAL_BASE_URL=      # 默认可留空，自动复用 LLM_BASE_URL
MULTIMODAL_MODEL=         # 默认可留空，自动复用 LLM_MODEL

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=club_management

# ---------- Redis (AI 微服务使用 DB 1) ----------
REDIS_URL=redis://localhost:6379/1

# ---------- Java 后端 ----------
JWT_SECRET=your-random-secret-at-least-32-bytes-long
MYSQL_URL=jdbc:mysql://localhost:3306/club_management?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
AI_SERVICE_URL=http://localhost:8000

# ---------- 前端 CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Java 和 Python 内部通信使用同一密钥（启用 AI 时填写）
AI_INTERNAL_API_KEY=
