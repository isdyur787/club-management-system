# ============================================
# 社团管理系统 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- AI 微服务 ----------
LLM_API_KEY=your-model-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.xiaomimimo.com/v1
FALLBACK_MODEL=mimo-v2.5
# 多模态配置留空时复用主模型
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=
MULTIMODAL_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
ANONYMIZED_TELEMETRY=False
AI_SERVICE_TIMEOUT=120000

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=club_management

# ---------- Redis (AI 微服务使用 DB 1) ----------
REDIS_URL=redis://localhost:6379/1

# ---------- Java 后端 ----------
JWT_SECRET=your-random-secret-at-least-32-bytes-long
MYSQL_URL=jdbc:mysql://localhost:3306/club_management?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
AI_SERVICE_URL=http://localhost:8000

# ---------- 前端 CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Java 和 Python 内部通信使用同一密钥（启用 AI 时填写）
AI_INTERNAL_API_KEY=
